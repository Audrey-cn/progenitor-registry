import re
from collections import Counter
from datetime import datetime

def parse_log_line(line):
    """解析单行日志"""
    patterns = [
        (r'\d{4}-\d{2}-\d{2}', 'date'),
        (r'\d{2}:\d{2}:\d{2}', 'time'),
        (r'ERROR', 'error'),
        (r'WARNING', 'warning'),
        (r'INFO', 'info'),
        (r'DEBUG', 'debug'),
    ]
    
    result = {'raw': line, 'timestamp': None, 'level': None, 'keywords': []}
    
    for pattern, field in patterns:
        match = re.search(pattern, line)
        if match:
            if field in ['error', 'warning', 'info', 'debug']:
                result['level'] = field.upper()
            else:
                result[field] = match.group()
            result['keywords'].append(field)
    
    return result

def analyze_logs(log_content):
    """分析日志内容，返回统计信息"""
    lines = [l.strip() for l in log_content.split('\n') if l.strip()]
    parsed = [parse_log_line(line) for line in lines]
    
    level_counts = Counter(p['level'] for p in parsed if p['level'])
    time_counts = Counter(p['time'] for p in parsed if p['time'])
    
    errors = [p for p in parsed if p['level'] == 'ERROR']
    warnings = [p for p in parsed if p['level'] == 'WARNING']
    
    return {
        'status': 'success',
        'total_lines': len(lines),
        'level_distribution': dict(level_counts),
        'error_count': len(errors),
        'warning_count': len(warnings),
        'recent_errors': errors[-5:] if errors else [],
        'analysis_timestamp': datetime.now().isoformat()
    }

def main():
    sample_log = '''
2026-05-10 10:30:15 INFO Application started
2026-05-10 10:30:16 WARNING Config file not found, using defaults
2026-05-10 10:30:17 ERROR Failed to connect to database
2026-05-10 10:30:18 INFO Retrying connection
2026-05-10 10:30:19 INFO Connection established
'''
    result = analyze_logs(sample_log)
    print(f"日志分析结果: {result}")
    return result
